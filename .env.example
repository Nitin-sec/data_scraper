# ================================
# Database
# ================================
DB_TYPE=mysql

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=<your_mysql_user>
MYSQL_PASSWORD=<your_mysql_password>
MYSQL_DB=job_notifier

# ================================
# Scheduler
# ================================
# 21600000 ms = 6 hours
SCHEDULE_INTERVAL_MS=21600000

# ================================
# Telegram
# ================================
TELEGRAM_API_ID=<your_telegram_api_id>
TELEGRAM_API_HASH=<your_telegram_api_hash>
TELEGRAM_PHONE_NUMBER=<your_phone_number>
TELEGRAM_SESSION_STRING=<your_session_string>
# Comma-separated group names or @usernames
TELEGRAM_GROUPS=<group1>,<group2>

# ================================
# LinkedIn / Indeed / Glassdoor
# No API keys required - scraped via python-jobspy
# ================================

# ================================
# Naukri
# No API keys required - uses Naukri's internal search endpoint
# ================================

# ================================
# Future: SerpAPI (Google Jobs)
# ================================
SERPAPI_KEY=<your_serpapi_key>

# ================================
# Future: RapidAPI
# ================================
RAPIDAPI_KEY=<your_rapidapi_key>
